rules_version = '2';

// Règles de sécurité MoodLove.
// Principe : ton humeur n'est visible que par toi et tes amies acceptées.
// À coller dans : console Firebase > Firestore Database > Règles > Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // Identifiant d'une paire d'amies, indépendant de l'ordre.
    function pairKey(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function isFriend(uid) {
      return exists(/databases/$(database)/documents/friendships/$(pairKey(uid, request.auth.uid)));
    }
    function selfOrFriend(uid) {
      return signedIn() && (uid == request.auth.uid || isFriend(uid));
    }

    // Profils : lisibles par toute personne connectée (c'est ce qui permet la recherche
    // d'amies par prénom). Ne contient qu'un prénom et un emoji, jamais l'e-mail.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && uid == request.auth.uid;

      // Journal personnel : strictement privé, personne d'autre n'y accède.
      match /journal/{entryId} {
        allow read, write: if signedIn() && uid == request.auth.uid;
      }
    }

    // Humeur du moment : visible uniquement par soi et ses amies.
    match /moods/{uid} {
      allow read: if selfOrFriend(uid);
      allow write: if signedIn() && uid == request.auth.uid;
    }

    // Jours où la personne a partagé une humeur (sert à la flamme du groupe).
    match /moodDays/{uid} {
      allow read: if selfOrFriend(uid);
      allow write: if signedIn() && uid == request.auth.uid;
    }

    // Réactions (coeur, bisou) : une amie peut en déposer une.
    match /reactions/{uid} {
      allow read: if selfOrFriend(uid);
      allow write: if selfOrFriend(uid);
    }

    // Réglages privés (dont le petit ami épinglé).
    match /settings/{uid} {
      allow read, write: if signedIn() && uid == request.auth.uid;
    }

    // Demandes d'amitié, identifiées "expediteur_destinataire".
    match /friendRequests/{reqId} {
      allow read: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to != request.auth.uid &&
        reqId == request.auth.uid + '_' + request.resource.data.to;
      allow delete: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Demandes de couple, identifiées "expediteur_destinataire".
    match /coupleRequests/{reqId} {
      allow read: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to != request.auth.uid &&
        reqId == request.auth.uid + '_' + request.resource.data.to;
      allow delete: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Couple : créé seulement par la personne qui ACCEPTE une demande existante.
    match /couples/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.users &&
        request.resource.data.from in request.resource.data.users &&
        request.resource.data.from != request.auth.uid &&
        exists(/databases/$(database)/documents/coupleRequests/$(request.resource.data.from + '_' + request.auth.uid));
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Amitiés : créées seulement par la personne qui ACCEPTE une demande existante.
    match /friendships/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.users &&
        request.resource.data.from in request.resource.data.users &&
        request.resource.data.from != request.auth.uid &&
        exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.from + '_' + request.auth.uid));
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }
  }
}
